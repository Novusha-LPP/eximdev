# ────────────────────────────────────────────────────────────────
# AIVision Market Intelligence — Environment Variables
# Copy to .env and fill in real values
# ────────────────────────────────────────────────────────────────

# ─── MongoDB ────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/market_intelligence
# Existing AIVision DBs (read-only for federation)
EXIM_MONGO_URI=mongodb://localhost:27017/eximNew
EXPORT_MONGO_URI=mongodb://localhost:27017/export

# ─── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Gateway (Node.js) ─────────────────────────────────────────
GATEWAY_PORT=3001
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRY=7d
NODE_ENV=development

# ─── Mystique (Python FastAPI) ──────────────────────────────────
MYSTIQUE_PORT=8100
MYSTIQUE_INTERNAL_URL=http://localhost:8100

# ─── Local LLM Configuration ───────────────────────────────────
# Option 1: Ollama (recommended for getting started)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama.alvision.in
OLLAMA_MODEL=gemma4

MODEL_CACHE_DIR=./models

# ─── Web (Next.js) ─────────────────────────────────────────────
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ─── Google Maps ────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─── External Integrations (Phase 2+) ──────────────────────────
TALLY_API_URL=
TALLY_API_KEY=
GST_PORTAL_API_KEY=
DGFT_API_KEY=

# ─── AWS S3 (existing) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
