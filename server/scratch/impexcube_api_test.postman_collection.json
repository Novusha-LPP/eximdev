{
	"info": {
		"_postman_id": "4020a50b-8d63-4f9e-beee-0b44081c7f42",
		"name": "IMEXCUBE API Collection",
		"description": "Collection to test IMEXCUBE login and fetch job details APIs for AMD, GIM, and COK branches with automatic token saving.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication (Login)",
			"item": [
				{
					"name": "Login - AMD Branch",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData && jsonData.success && jsonData.data && jsonData.data.accessToken) {",
									"    pm.collectionVariables.set(\"accessToken\", jsonData.data.accessToken);",
									"    console.log(\"AMD Token saved to variable: 'accessToken'\");",
									"}"
								],
								"type": "javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "accept",
								"value": "*/*"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/Authentication/login?username={{username}}&password={{password}}&CompanyBrCode={{companyBrCode_AMD}}&Fyear={{fyear}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"Authentication",
								"login"
							],
							"query": [
								{
									"key": "username",
									"value": "{{username}}"
								},
								{
									"key": "password",
									"value": "{{password}}"
								},
								{
									"key": "CompanyBrCode",
									"value": "{{companyBrCode_AMD}}"
								},
								{
									"key": "Fyear",
									"value": "{{fyear}}"
								}
							]
						}
					},
					"response": []
				},
